{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClassJourney Classroomscreen Sammlung v1",
  "type": "object",
  "required": ["format", "version", "libraryId", "modifiedAt", "plans", "assets", "settings"],
  "properties": {
    "format": {"const": "classroomscreen"},
    "version": {"const": 1},
    "libraryId": {"type": "string", "description": "Kennung der Sammlung; bei Aktualisierungen erhalten."},
    "modifiedAt": {"type": "number", "description": "Änderungszeit als Unix-Millisekunden; bei Änderungen aktualisieren."},
    "plans": {"type": "array", "items": {"$ref": "#/$defs/plan"}, "maxItems": 1000},
    "assets": {
      "type": "object",
      "properties": {
        "backgrounds": {"type": "object", "additionalProperties": {"type": "object", "required": ["name", "src"], "properties": {"name": {"type": "string"}, "src": {"$ref": "#/$defs/image"}, "prompt": {"type": "string"}}}},
        "atlas": {"type": "string", "description": "Vorhandenes transparentes 3x2-Symbolraster Allgemein. Unverändert erhalten."},
        "fageAtlas": {"type": "string", "description": "Vorhandenes transparentes 3x2-Symbolraster FaGe. Unverändert erhalten."}
      },
      "required": ["backgrounds", "atlas", "fageAtlas"]
    },
    "settings": {"type": "object", "properties": {"motion": {"type": "boolean"}, "backgroundOpacity": {"type": "number", "minimum": 0, "maximum": 0.65}}}
  },
  "$defs": {
    "image": {"type": "string", "pattern": "^data:image/(png|jpeg|webp|gif);base64,", "description": "Eingebettetes Rasterbild, keine externe Adresse."},
    "plan": {
      "type": "object",
      "required": ["id", "title", "className", "topic", "weekday", "date", "slots", "activities", "backgroundId"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string", "maxLength": 180},
        "className": {"type": "string", "maxLength": 80}, "topic": {"type": "string", "maxLength": 140},
        "weekday": {"type": "integer", "minimum": 0, "maximum": 6, "description": "0 Sonntag, 1 Montag, 2 Dienstag, … 6 Samstag."},
        "date": {"type": "string", "description": "YYYY-MM-DD oder leer; falls angegeben bestimmt das Datum den Wochentag."},
        "slots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}, "end": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}}}, "description": "Feste, nicht überlappende Lektionsfenster. Lücken sind feste Pausen."},
        "activities": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/activity"}},
        "backgroundId": {"type": "string", "description": "Kennung eines vorhandenen Eintrags in assets.backgrounds."},
        "example": {"type": "boolean"}, "updatedAt": {"type": "number"}
      }
    },
    "activity": {
      "type": "object",
      "required": ["id", "title", "description", "duration", "icon", "image"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string", "maxLength": 180}, "description": {"type": "string", "maxLength": 2000},
        "duration": {"type": "integer", "minimum": 1, "maximum": 1440, "description": "Arbeitsminuten; feste Lektionspausen werden nicht mitgezählt. Nie ungefragt kürzen."},
        "icon": {"enum": ["idea", "puzzle", "break", "notebook", "talk", "check", "health", "hygiene", "care", "mobility", "resources", "rest"], "description": "Fallback aus der manuellen Bibliothek."},
        "image": {"type": "string", "description": "Für neu generierte Symbole ein individuelles eingebettetes Rasterbild; leer verwendet den Bibliotheks-Fallback."}
      }
    }
  }
}
